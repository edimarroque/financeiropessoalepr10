{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh; worker-src 'self' blob:; connect-src 'self' https://sqkvmpuhtsjeabmjdvgc.supabase.co wss://sqkvmpuhtsjeabmjdvgc.supabase.co https://esm.sh https://economia.awesomeapi.com.br; img-src 'self' data: blob: https://sqkvmpuhtsjeabmjdvgc.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self' blob: https://sqkvmpuhtsjeabmjdvgc.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/ler-pdf.js": {
      "maxDuration": 60
    },
    "api/ia.js": {
      "maxDuration": 60
    },
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/drive.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 11 * * *"
    }
  ]
}